# Copiar a .env.local para desarrollo local / Cloud Agent.
# Ver ENV_SETUP.md para valores reales de producción.

NEXT_PUBLIC_PLAN=pro

# Noticias en la app: false si nadie cura/publica (evita textos demo o notas viejas)
NEXT_PUBLIC_ENABLE_NOTICIAS=false

# Obligatorias para compilar (placeholders OK para UI; APIs con DB requieren claves reales)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Evita consultar tenant_subscriptions en dev sin DB
SUBSCRIPTION_STATUS=active
TENANT_ID=bienvenida-933

# Sanity CMS (público en build)
NEXT_PUBLIC_SANITY_PROJECT_ID=nmwhp66x
NEXT_PUBLIC_SANITY_DATASET=production

# Demo comercial: fuerza campañas de ejemplo (presentaciones / ventas)
# NEXT_PUBLIC_FORCE_DEMO_ADS=true

# Suscripción BBX (ver docs/BBX_SUSCRIPCION.md)
# SUBSCRIPTION_GRACE_DAYS=7

# Mercado Pago (cuando actives la API)
# MERCADOPAGO_ACCESS_TOKEN=
# NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# Centro de operaciones BBX (alertas super admin — ver ENV_SETUP.md)
# BBX_OPS_WEBHOOK_URL=https://ntfy.sh/tu-topic-privado
# BBX_OPS_NOTIFY_PHONE=56922105555
# BBX_OPS_CRON_SECRET=

# Twilio SMS opcional (alertas críticas)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=

# Stripe (opcional)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Push oyentes (admin radio → /admin → Comunicación). Ver supabase-push.sql + npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@tudominio.com

# Opcional: admin / studio
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Obligatorio en dev (no vacío): firma cookies de oyentes/admin. Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_SESSION_SECRET=
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=
